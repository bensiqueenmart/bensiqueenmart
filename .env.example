# Copy to .env and fill in your Atlas credentials. Never commit .env.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/bensi-queen-mart?retryWrites=true&w=majority
MONGODB_DB=bensi-queen-mart

# Admin-console auth (local dev + Vercel env vars on the admin project only).
# Generate the hash with: echo -n '<password>' | shasum -a 256
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_USER=admin
ADMIN_PASS_SHA256=<sha256 hex of the admin password>
AUTH_SECRET=<64-hex-char random secret>

# Billing-desk auth (local dev + Vercel env vars on the billing project only).
# Isolated from admin-console: separate username + password hash.
# Same hash recipe: echo -n '<billing password>' | shasum -a 256
BILLING_USER=billing
BILLING_PASS_SHA256=<sha256 hex of the billing-desk password>

# Cloudinary image uploads (server-only — never prefix with VITE_).
# From the Cloudinary dashboard (Settings → API keys). The key needs the
# upload/create role; delete all unsigned upload presets in the dashboard.
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>

# Website edit console — GitHub commits for src/data/*.json (fine-grained PAT,
# Contents: Read & Write on this repo only). No separate edit login: the admin
# session cookie authorizes these calls.
GITHUB_TOKEN=<fine-grained-pat-contents-read-write>
GITHUB_OWNER=<repo owner>
GITHUB_REPO=<repo name>
GITHUB_BRANCH=main
